#!/bin/bash

set -euo pipefail

function run_in_sniper() {
    script_file=$(basename -- "$script")
    check_env=$(sha256sum -- "$script" | cut -d " " -f 1)

    if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
        container_runtime="${SOURCE_SDK_CONTAINER_RUNTIME:-}"

        if [[ -z "$container_runtime" ]]; then
            if command -v podman &> /dev/null; then
                container_runtime="podman"
            elif command -v docker &> /dev/null; then
                container_runtime="docker"
            fi
        fi

        if [[ "$container_runtime" != "podman" && "$container_runtime" != "docker" ]]; then
            echo "Error: podman or docker is required to run the Steam Runtime SDK container."
            exit 1
        fi

        if [[ "$container_runtime" == "docker" ]] && ! docker info >/dev/null 2>&1; then
            echo "Error: docker is installed, but the Docker daemon is unavailable."
            echo "Start Docker Desktop, enable WSL2 integration, or set SOURCE_SDK_CONTAINER_RUNTIME=podman."
            exit 1
        fi

        # Let's say we run as /home/misyl/my_mod/src/myscript
        # We want to mount /home/misyl/my_mod, and then launch
        # src/myscript inside of that.
        #
        # The below achieves that.
        mod_src_dir=$(pwd)
        mod_src_dir_name=$(basename -- "$mod_src_dir")
        mod_base_dir=$(dirname -- "$mod_src_dir")
        ccache_dir="${CCACHE_DIR:-$HOME/.ccache}"
        mkdir -p "$ccache_dir"

        image="registry.gitlab.steamos.cloud/steamrt/sniper/sdk:latest"
        echo "Running script inside $image with $container_runtime"

        if [[ "$container_runtime" == "podman" ]]; then
            exec podman run \
                --env "$check_env=$script_file" \
                --env "CCACHE_DIR=$ccache_dir" \
                --userns=keep-id \
                --rm -it \
                --mount type=bind,\"source="$ccache_dir"\",\"target="$ccache_dir"\" \
                --mount type=bind,\"source="$mod_base_dir"\",target=/my_mod/ \
                "$image" \
                /my_mod/"$mod_src_dir_name"/"$script_file" \
                "$@"
        else
            exec docker run \
                --env "$check_env=$script_file" \
                --env "CCACHE_DIR=$ccache_dir" \
                --user "$(id -u):$(id -g)" \
                --rm -i \
                --mount type=bind,\"source="$ccache_dir"\",\"target="$ccache_dir"\" \
                --mount type=bind,\"source="$mod_base_dir"\",target=/my_mod/ \
                "$image" \
                /my_mod/"$mod_src_dir_name"/"$script_file" \
                "$@"
        fi
    fi

    if [[ $(printenv -- "$check_env") != "$script_file" ]]; then
        echo "Can't run in a nested container setup. Sorry! :("
        exit 1
    fi
}
