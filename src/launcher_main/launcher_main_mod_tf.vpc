$Macro OUTBINNAME "tfvr"

$Conditional "MOD_LAUNCHER" "1"

$Include "launcher_main.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;MOD_APPID=1055600" // Replace with your appid if you ship on Steam.
	}
}

$Project "Launcher Main (TFVR)"
{
    $Folder "Resource Files" [$WINDOWS]
    {
        $File   "launcher_main_mod_tf.rc"
        $File   "res\mod_tf.ico"
    }
}